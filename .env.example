# Servidor
PORT=3000
NODE_ENV=development

# JWT + Cookies
JWT_SECRET=cambia_este_secreto_por_uno_seguro
JWT_EXPIRES_IN=7d

# Base de datos - Turso (libSQL)
TURSO_DATABASE_URL=libsql://tu-db.turso.io
TURSO_AUTH_TOKEN=tu_auth_token_aqui

# Fallback local (opcional)
# TURSO_DATABASE_URL=file:./Database/Database.db
# TURSO_AUTH_TOKEN no se requiere con file:
